# Apache 2.4: HTTPS in front of deploy/serve.py on 127.0.0.1:8000. Needs mod_ssl, mod_proxy, mod_proxy_http and
# mod_headers. Replace @SERVER_NAME@ and the certificate paths.
# mod_proxy adds X-Forwarded-For; the app trusts it only with PROD_TRUSTED_PROXIES=1 in its env file; set it.
<VirtualHost *:80>
    ServerName @SERVER_NAME@
    Redirect permanent / https://@SERVER_NAME@/
</VirtualHost>

<VirtualHost *:443>
    ServerName @SERVER_NAME@
    SSLEngine on
    SSLCertificateFile    /etc/ssl/certs/@SERVER_NAME@.pem
    SSLCertificateKeyFile /etc/ssl/private/@SERVER_NAME@.key
    Header always set Strict-Transport-Security "max-age=31536000"

    LimitRequestBody 65536
    # An admin publish carries the whole diff, then backs up the database and rebuilds the knowledge pages.
    <Location "/api/publish">
        LimitRequestBody 33554432
    </Location>

    # Drop any client-sent X-Forwarded-For so mod_proxy's is the only address.
    RequestHeader unset X-Forwarded-For early
    RequestHeader set X-Forwarded-Proto https
    ProxyPreserveHost On
    ProxyTimeout 300
    ProxyPass        / http://127.0.0.1:8000/
    ProxyPassReverse / http://127.0.0.1:8000/
</VirtualHost>
